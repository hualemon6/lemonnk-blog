---
// Layout.astro — 全站通用外壳：head、导航、内容区、页脚
import Header from '../components/Header.astro';
import { site } from '../config/site';
import { path } from '../utils/path';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import '../styles/prose.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const { title = site.title, description = site.description, bodyClass } = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={path('/favicon.svg')} />
    <title>{title}</title>
    <!-- 防闪烁：页面渲染前先恢复主题和语言，避免黑白模式闪一下 -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme) document.documentElement.dataset.theme = theme;
          var lang = localStorage.getItem('lang');
          if (lang === 'en') document.documentElement.lang = 'en';
        } catch (e) {}
      })();
    </script>
  </head>
  <body class:list={{ [bodyClass]: !!bodyClass }}>
    <Header />
    <main class="container">
      <slot />
    </main>
    <footer class="footer">
      <p>© {new Date().getFullYear()} {site.name}</p>
    </footer>
    <script>
      import '../utils/client';
    </script>
  </body>
</html>

<style>
  .container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--space-sm);
    min-height: 70vh;
  }

  .footer {
    max-width: var(--page-width);
    margin: var(--space-lg) auto 0;
    padding: var(--space-md) var(--space-sm) var(--space-lg);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }
</style>
