---
// PostLayout.astro — 文章页专用外壳：标题区 + 正文 + 上一篇/下一篇
import Layout from './Layout.astro';
import PostMeta from '../components/PostMeta.astro';
import { path } from '../utils/path';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags: string[];
  readingTime: number;
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
}

const { title, description, pubDate, tags, readingTime, prev, next } = Astro.props;
---

<Layout title={title} description={description} bodyClass="page-prose">
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <PostMeta pubDate={pubDate} readingTime={readingTime} tags={tags} />
    </header>

    <div class="prose">
      <slot />
    </div>

    <nav class="post-nav">
      {prev && <a href={path(`/posts/${prev.slug}`)} class="nav-link">← {prev.title}</a>}
      {next && <a href={path(`/posts/${next.slug}`)} class="nav-link"> {next.title} →</a>}
    </nav>
  </article>
</Layout>

<style>
  .post-header {
    margin: var(--space-md) 0 var(--space-lg);
  }

  h1 {
    font-size: var(--font-size-title);
    line-height: var(--line-height-tight);
    margin: var(--space-sm) 0 var(--space-sm);
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    font-size: var(--font-size-small);
  }

  .nav-link {
    color: var(--color-text-muted);
    max-width: 45%;
  }
</style>
