---
import type { WindowSide } from '../config/map';
import Icon from './Icon.astro';

interface Props {
  id: string;
  titleKey: string;
  title: string;
  width: number;
  side?: WindowSide;
  index?: number;
  open?: boolean;
  scroll?: 'none' | 'scroll' | 'scroll-tall';
  editable?: boolean;
  chrome?: boolean;
  labelled?: string;
}

const {
  id,
  titleKey,
  title,
  width,
  side = 'tl',
  index = 0,
  open = true,
  scroll = 'none',
  editable = true,
  chrome = false,
  labelled,
} = Astro.props;

const bodyClass = ['window-body', scroll !== 'none' ? `is-${scroll}` : ''].filter(Boolean).join(' ');
---
<section
  class="float-window glass"
  data-window={id}
  data-side={side}
  data-open={open ? 'true' : 'false'}
  data-editable={editable ? 'true' : 'false'}
  data-chrome={chrome ? 'true' : 'false'}
  hidden={!open}
  style={`--ww: ${width}px; --w-index: ${index};`}
  aria-label={labelled}
>
  <header class="window-bar" data-window-bar>
    <span class="window-grip" aria-hidden="true"></span>
    <span class="window-title" data-i18n={titleKey}>{title}</span>
    {editable && (
      <div class="window-actions">
        <button class="window-button" type="button" data-window-collapse title="收起" aria-label="收起" data-i18n-title="window.collapse" data-i18n-aria="window.collapse">
          <Icon name="collapse" size={14} />
        </button>
        <button class="window-button" type="button" data-window-close title="关闭" aria-label="关闭" data-i18n-title="window.close" data-i18n-aria="window.close">
          <Icon name="close" size={14} />
        </button>
      </div>
    )}
  </header>
  <div class={bodyClass}>
    <slot />
  </div>
</section>
