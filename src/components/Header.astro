---
// Header.astro — 顶部导航
// 三栏：左 Logo / 中导航 / 右工具按钮。容器比正文宽，让站名自然靠左
// 滚动后：站名和工具按钮常驻，中间导航项淡出；无边框、无阴影
import { site } from '../config/site';
import { path } from '../utils/path';

const links = [
  { href: '/', label: '文章', key: 'nav.writing' },
  { href: '/archive/', label: '归档', key: 'nav.archive' },
  { href: '/projects/', label: '项目', key: 'nav.projects' },
  { href: '/about/', label: '关于', key: 'nav.about' },
];

// 当前页面路径（去掉 base 前缀），用于激活态比较
const { pathname } = Astro.url;
const current = pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');
---

<header class="site-header">
  <div class="header-inner">
    <a href={path('/')} class="site-name">{site.name}</a>

    <nav class="site-nav">
      {links.map((link) => (
        <a
          href={path(link.href)}
          data-i18n={link.key}
          class:list={{ active: current === link.href }}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button
        class="icon-btn"
        data-action="theme"
        type="button"
        title="切换主题"
        aria-label="切换主题"
        data-i18n-title="toggle.theme"
        data-i18n-aria="toggle.theme"
      >
        <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg class="icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
      <button
        class="lang-btn"
        data-action="lang"
        type="button"
        title="切换语言"
        aria-label="切换语言"
        data-i18n-title="toggle.language"
        data-i18n-aria="toggle.language"
      >EN</button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* 完全透明：滚动时正文直接从下方穿过，可以完全阅读，不做毛玻璃 */
  }

  /* 滚动后加一点点很弱的底色，避免站名和正文文字叠在一起难辨认（不影响正文可读性） */
  .site-header.scrolled {
    background: color-mix(in srgb, var(--color-bg) 30%, transparent);
  }

  .header-inner {
    max-width: var(--header-width);
    margin: 0 auto;
    padding: var(--space-sm) var(--space-md);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .site-name {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    justify-self: start;
  }

  .site-nav {
    display: flex;
    gap: var(--space-md);
    font-size: 15px;
    transition: opacity 0.2s ease;
  }

  .site-nav a {
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .site-nav a:hover,
  .site-nav a.active {
    color: var(--color-text);
  }

  .site-header.scrolled .site-nav {
    opacity: 0;
    pointer-events: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    justify-self: end;
  }

  .icon-btn,
  .lang-btn {
    background: none;
    border: none;
    padding: 0.3rem 0.45rem;
    border-radius: 6px;
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: var(--font-size-small);
    line-height: 1;
  }

  .icon-btn:hover,
  .lang-btn:hover {
    color: var(--color-text);
    background: var(--color-code-bg);
  }

  .icon {
    width: 16px;
    height: 16px;
    display: block;
  }

  .icon-moon {
    display: none;
  }

  :root[data-theme='dark'] .icon-sun {
    display: none;
  }

  :root[data-theme='dark'] .icon-moon {
    display: block;
  }

  @media (max-width: 720px) {
    .header-inner {
      padding: var(--space-sm);
      gap: var(--space-xs);
    }
  }

  @media (max-width: 640px) {
    .header-inner {
      grid-template-columns: 1fr auto;
    }

    .site-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: space-between;
      gap: var(--space-xs);
      padding-top: var(--space-xs);
      font-size: 14px;
    }

    .site-header.scrolled .site-nav {
      display: none;
    }
  }
</style>
