---
import { site } from '../config/site';
import { ui } from '../config/i18n';
import { path } from '../utils/path';
import Icon from './Icon.astro';

interface Props {
  floors?: { id: string; label: string }[];
  activeFloor?: string;
}

const { floors = [], activeFloor } = Astro.props;

const links = [
  { href: '/', label: '经历', key: 'nav.journey' },
  { href: '/archive/', label: '文章', key: 'nav.writing' },
  { href: '/projects/', label: '项目', key: 'nav.projects' },
  { href: '/about/', label: '关于', key: 'nav.about' },
];

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');
---
<header class="site-header">
  <a href={path('/')} class="site-name glass" aria-label="LemonNK 首页" data-i18n-aria="nav.home">
    <svg class="brand-symbol" width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <path d="M6 5h7v15h13v7H6V5Z" fill="currentColor" />
      <path d="M17 5h9v11h-9V5Z" fill="currentColor" opacity=".35" />
    </svg>
    <span>{site.name}<small>NOTES &amp; MOMENTS</small></span>
  </a>

  <div class="header-capsule glass">
    <nav class="site-nav" aria-label="主导航" data-i18n-aria="nav.label">
      {links.map((link) => {
        const active = current === link.href ||
          (link.href === '/' && current === '') ||
          (link.href === '/archive/' && current.startsWith('/posts/')) ||
          (link.href === '/projects/' && current.startsWith('/projects')) ||
          (link.href === '/about/' && current.startsWith('/about'));
        return (
          <a href={path(link.href)} data-i18n={link.key} class:list={{ active }} aria-current={active ? 'page' : undefined}>
            {link.label}
          </a>
        );
      })}
    </nav>

    <span class="header-divider" aria-hidden="true"></span>

    {floors.length > 1 && (
      <label class="floor-switch">
        <Icon name="layers" size={14} />
        <select data-floor-select aria-label="切换楼层" data-i18n-aria="map.floor">
          {floors.map((floor) => (
            <option value={floor.id} selected={floor.id === activeFloor}>
              {floor.id === 'collection' ? ui.zh['journey.collection'] : floor.label}
            </option>
          ))}
        </select>
      </label>
    )}

    <div class="header-tools">
      <button class="icon-button" data-action="theme" type="button" title="切换主题" aria-label="切换主题" data-i18n-title="toggle.theme" data-i18n-aria="toggle.theme">
        <span class="icon-sun"><Icon name="sun" size={16} /></span>
        <span class="icon-moon"><Icon name="moon" size={16} /></span>
      </button>
      <button class="icon-button" data-action="lang" type="button" title="切换语言" aria-label="切换语言" data-i18n-title="toggle.language" data-i18n-aria="toggle.language">EN</button>
    </div>
  </div>
</header>
