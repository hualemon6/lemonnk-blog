---
import type { MapModel, MapNode } from '../config/map';
import { NODE, TRUNK } from '../config/map';
import { path } from '../utils/path';

interface Props {
  model: MapModel;
  floor: string;
  mode?: 'floor' | 'all';
  selectedId?: string;
  highlightIds?: string[];
}

const { model, floor, mode = 'floor', selectedId, highlightIds } = Astro.props;
const highlights = new Set(highlightIds ?? []);
const { width, height } = model.world;

const gridStep = 130;
const gridLines: string[] = [];
for (let x = 0; x <= width; x += gridStep) gridLines.push(`M${x} 0V${height}`);
for (let y = 0; y <= height; y += gridStep) gridLines.push(`M0 ${y}H${width}`);

function glyph(visual: string): string {
  if (visual === 'code') {
    return '<path d="M-14 -11-26 0-14 11M14 -11 26 0 14 11M4 -14-4 14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>';
  }
  if (visual === 'signal') {
    return [0, 1, 2, 3, 4, 5, 6]
      .map((index) => {
        const bar = 6 + Math.abs(Math.sin(index * 1.1)) * 22;
        return `<rect x="${-24 + index * 8}" y="${11 - bar}" width="4.5" height="${bar}" rx="2.2" fill="currentColor"/>`;
      })
      .join('');
  }
  if (visual === 'network') {
    const points = [[-24, -12], [0, -16], [24, -8], [-12, 12], [14, 13]];
    const links = [[0, 1], [1, 2], [0, 3], [3, 4], [1, 4], [2, 4]];
    return (
      links
        .map(([a, b]) => `<path d="M${points[a][0]} ${points[a][1]}L${points[b][0]} ${points[b][1]}" stroke="currentColor" stroke-width="1.1" opacity=".5" fill="none"/>`)
        .join('') + points.map(([x, y]) => `<circle cx="${x}" cy="${y}" r="2.6" fill="currentColor"/>`).join('')
    );
  }
  if (visual === 'journal') {
    return '<path d="M-24 -12H18M-24 -1H22M-24 10H6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none"/><circle cx="22" cy="10" r="3.4" fill="currentColor"/>';
  }
  return [0, 1, 2]
    .map((row) => [0, 1, 2, 3].map((col) => `<rect x="${-25 + col * 14}" y="${-14 + row * 12}" width="10" height="8.5" rx="2.4" fill="currentColor" opacity=".8"/>`).join(''))
    .join('');
}

function nodeScale(node: MapNode) {
  return highlights.size && !highlights.has(node.id) ? ' is-dimmed' : '';
}
---

<div
  class="map-stage"
  data-map-stage
  data-mode={mode}
  data-floor={floor}
  data-selected={selectedId}
  role="application"
  tabindex="0"
  aria-label="经历地图"
  data-i18n-aria="map.label"
>
  <div class="map-camera" data-map-camera>
    <svg
      class="map-world"
      data-map-world
      data-lod="mid"
      width={width}
      height={height}
      viewBox={`0 0 ${width} ${height}`}
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient id="nodeScrim" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0.35" stop-color="#000" stop-opacity="0" />
          <stop offset="1" stop-color="#000" stop-opacity="0.72" />
        </linearGradient>
        <clipPath id="nodeClip">
          <rect width={NODE.width} height={NODE.height} rx="16" />
        </clipPath>
      </defs>

      <rect class="world-plate" width={width} height={height} />
      <g class="world-grid">{gridLines.map((d) => <path d={d} />)}</g>

      {model.regions.map((region) => (
        <g class="map-region" data-region={region.id} data-region-plate>
          <rect class="region-plate" x={region.x} y={region.y} width={region.width} height={region.height} rx="34" />
          <rect class="region-tint" x={region.x} y={region.y} width={region.width} height={region.height} rx="34" />
          <rect class="region-tag" x={region.x + 46} y={region.y + 44} width="12" height="12" rx="4" />
          <text class="region-label" x={region.x + 72} y={region.y + 56} data-i18n={`journey.${region.id}`} data-region-label>{region.id}</text>
          <text class="region-count" x={region.x + region.width - 46} y={region.y + 56} text-anchor="end" data-region-count data-n={region.count}>
            {String(region.count).padStart(2, '0')}
          </text>
        </g>
      ))}

      <g class="map-trunk" aria-hidden="true">
        <path d={TRUNK.d} />
        {TRUNK.junctions.map((junction) => <circle class="junction" cx={junction.x} cy={junction.y} r="7" />)}
      </g>

      {model.nodes.map((node) => (
        <g
          class:list={['map-node', { 'is-selected': node.id === selectedId, 'is-dimmed': mode === 'floor' && node.floor !== floor }, nodeScale(node)]}
          data-node={node.id}
          data-category={node.category}
          data-floor={node.floor}
          data-date={node.date ?? ''}
          data-title={node.title}
          data-url={node.url ?? ''}
          data-external={node.external ? 'true' : 'false'}
          data-highlight={highlights.has(node.id) ? 'true' : undefined}
          transform={`translate(${node.x} ${node.y})`}
          role="button"
          tabindex="-1"
        >
          <rect class="node-halo" x="-7" y="-7" width={NODE.width + 14} height={NODE.height + 14} rx="22" />
          <rect class="node-plate" width={NODE.width} height={NODE.height} rx="16" />
          {node.image && (
            <g clip-path="url(#nodeClip)">
              <image class="node-thumb" href={path(node.image)} x="0" y="0" width={NODE.width} height={NODE.height} preserveAspectRatio="xMidYMid slice" />
              <rect class="node-scrim" x="0" y="0" width={NODE.width} height={NODE.height} fill="url(#nodeScrim)" />
            </g>
          )}
          <g class="node-glyph" transform={`translate(${NODE.width / 2} ${NODE.height / 2})`} set:html={glyph(node.visual)} />
          <text class="node-date" x={NODE.width / 2} y={NODE.height + 30}>{node.date ? node.date.slice(5).replace('-', ' / ') : ''}</text>
          <text class="node-title" x={NODE.width / 2} y={NODE.height + 56}>{node.title}</text>
        </g>
      ))}
    </svg>
  </div>

  <p class="map-hint" data-map-hint data-i18n="map.hint">滚轮缩放 · 拖拽平移 · 点节点查看详情</p>
</div>
