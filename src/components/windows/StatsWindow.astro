---
import Window from '../Window.astro';
import { WINDOW_SPECS } from '../../config/map';

interface Props {
  count: number;
  years: number;
  minutes: number;
}

const { count, years, minutes } = Astro.props;
const spec = WINDOW_SPECS.stats;

const bars = [0.35, 0.62, 0.44, 0.86, 0.55, 0.72, 0.4, 0.95, 0.5, 0.68, 0.38, 0.8];
const stats = [
  { value: String(count).padStart(2, '0'), key: 'map.statEntries', label: '条记录' },
  { value: String(years).padStart(2, '0'), key: 'map.statYears', label: '个年份' },
  { value: String(minutes), key: 'map.statMinutes', label: '分钟阅读' },
];
---
<Window id="stats" titleKey="window.stats" title="指标" width={spec.width!} side={spec.side} labelled="站点指标">
  <div class="stats">
    {stats.map((stat) => (
      <div class="stat">
        <p class="stat-value">{stat.value}</p>
        <p class="stat-label" data-i18n={stat.key}>{stat.label}</p>
      </div>
    ))}
    <div class="stat-spark" aria-hidden="true">
      {bars.map((height, index) => (
        <span style={`--h: ${height}; --i: ${index}`}></span>
      ))}
    </div>
  </div>
</Window>

<style>
  .stats { display: flex; align-items: flex-end; gap: 22px; }
  .stat-value {
    font-size: 30px;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .stat-label { margin-top: 4px; font-size: var(--font-size-caption); color: var(--color-text-muted); }
  .stat-spark { display: flex; align-items: flex-end; gap: 2.5px; height: 34px; margin-left: auto; }
  .stat-spark span {
    display: block;
    width: 3px;
    height: calc(6px + var(--h) * 26px);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-research) 55%, transparent);
    animation: spark-in 620ms calc(var(--i) * 40ms) cubic-bezier(0.22, 0.82, 0.2, 1) both;
  }
  @keyframes spark-in {
    from { transform: scaleY(0.2); opacity: 0; }
    to { transform: scaleY(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stat-spark span { animation: none; }
  }
</style>
