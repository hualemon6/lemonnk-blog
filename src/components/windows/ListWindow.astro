---
import Window from '../Window.astro';
import { WINDOW_SPECS } from '../../config/map';

interface Props {
  titleKey: string;
  title: string;
  labelled: string;
  scroll?: 'none' | 'scroll' | 'scroll-tall';
}

const { titleKey, title, labelled, scroll = 'scroll-tall' } = Astro.props;
const spec = WINDOW_SPECS.list;
---
<Window id="list" titleKey={titleKey} title={title} width={spec.width!} side={spec.side} labelled={labelled} scroll={scroll}>
  <div class="list-window">
    <slot />
  </div>
</Window>

<style>
  .list-window { font-size: var(--font-size-ui); }
  .list-window :global(h2),
  .list-window :global(h3) { font-size: var(--font-size-card); font-weight: 620; letter-spacing: -0.02em; }
  .list-window :global(ol),
  .list-window :global(ul) { list-style: none; margin: 0; padding: 0; }
  .list-window :global(a:hover) { color: var(--color-accent); }
</style>
