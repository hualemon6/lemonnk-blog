---
// PostMeta.astro — 「日期 · 阅读时长 · 标签」一行，全站复用
// 想改日期格式或展示方式，只改这里
import { path } from '../utils/path';

interface Props {
  pubDate: Date;
  readingTime: number;
  tags: string[];
  authoringMode?: 'me' | 'ai';
}

const { pubDate, readingTime, tags, authoringMode } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<p class="post-meta">
  <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
  <span class="dot">·</span>
  <span data-i18n="minRead" data-n={readingTime}>约 {readingTime} 分钟</span>
  {tags.length > 0 && (
    <>
      <span class="dot">·</span>
      <span class="tags">
        {tags.map((tag) => (
          <a href={path(`/tags/${tag}/`)} class="tag">{tag}</a>
        ))}
      </span>
    </>
  )}
  {authoringMode && <span class="edition-mark" title={authoringMode === 'me' ? 'Author-written edition' : 'AI-authored edition'}>{authoringMode.toUpperCase()}</span>}
</p>

<style>
  .post-meta {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em;
  }

  .tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.45em;
  }

  .tag + .tag::before {
    color: var(--color-border);
    content: '·';
    margin-right: 0.45em;
  }

  .tag:hover {
    color: var(--color-accent);
  }

  .edition-mark {
    align-items: center;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: var(--color-text-muted);
    display: inline-flex;
    font-size: 9px;
    font-weight: 700;
    height: 20px;
    justify-content: center;
    letter-spacing: .045em;
    line-height: 1;
    margin-left: .35em;
    padding: 0 5px;
  }
</style>
