---
import Layout from '../layouts/Layout.astro';
import MapShell from '../components/MapShell.astro';
import Window from '../components/Window.astro';
import IdentityWindow from '../components/windows/IdentityWindow.astro';
import { loadMap, DOCK_WINDOWS } from '../config/model';
import { WINDOW_SPECS } from '../config/map';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import about from '../data/about.json';
import { path } from '../utils/path';

const { model, floors, defaultFloor } = await loadMap();
const windows = DOCK_WINDOWS.filter((item) => ['identity', 'about'].includes(item.id));
const processor = await createMarkdownProcessor();
const { code: content } = about.content.trim() ? await processor.render(about.content) : { code: '' };
const spec = WINDOW_SPECS.about;
const facts = [
  { label: about.type, href: 'https://en.wikipedia.org/wiki/Myers%E2%80%93Briggs_Type_Indicator' },
  { label: about.major, href: 'https://is.nju.edu.cn/' },
  { label: `爱专 · ${about.album}`, href: 'https://music.apple.com/cn/album/%E6%96%B0%E5%9C%B0%E7%90%83/1788007687?uo=4' },
];
---

<Layout title="关于我 · LemonNK" floors={floors} activeFloor={defaultFloor}>
  <MapShell model={model} floor="all" mode="all" selectedId={model.nodes.at(-1)?.id} windows={windows}>
    <IdentityWindow />
    <Window id="about" titleKey="window.about" title="关于我" width={spec.width!} side={spec.side} labelled="关于我" scroll="scroll-tall">
      <article class="about">
        <header class="about-head">
          <a class="about-portrait" href={path('/about/')} aria-label="LemonNK 的头像">
            <img src={path(about.avatar || '/images/profile/home-avatar.webp')} alt="LemonNK 的头像" width="120" height="120" />
          </a>
          <div class="about-copy">
            <h1>LemonNK</h1>
            <nav class="about-facts" aria-label="Profile links">
              {facts.map((fact) => <a href={fact.href} target="_blank" rel="noopener noreferrer">{fact.label}</a>)}
            </nav>
          </div>
        </header>
        {content
          ? <div class="about-content prose" set:html={content} />
          : <p class="about-empty">这里还空着。想写点什么的时候，补上就好。</p>}
      </article>
    </Window>
  </MapShell>
</Layout>

<style>
  .about-head { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 18px; align-items: center; }
  .about-portrait img {
    width: 88px; height: 88px; object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--glass-rim-outer);
  }
  .about-copy h1 { font-size: 30px; font-weight: 680; letter-spacing: -0.045em; line-height: 1; }
  .about-facts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .about-facts a {
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-panel-soft);
    color: var(--color-text-muted);
    font-size: var(--font-size-caption);
    transition: color 150ms ease, background 150ms ease;
  }
  .about-facts a:hover { color: var(--color-accent); background: var(--color-accent-soft); }
  .about-content { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--glass-rim-outer); }
  .about-content :global(.prose) { max-width: none; }
  .about-empty { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--glass-rim-outer); color: var(--color-text-muted); font-size: var(--font-size-small); }
</style>
