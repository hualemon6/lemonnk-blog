---
import Layout from '../layouts/Layout.astro';
import MapShell from '../components/MapShell.astro';
import IdentityWindow from '../components/windows/IdentityWindow.astro';
import LegendWindow from '../components/windows/LegendWindow.astro';
import ListWindow from '../components/windows/ListWindow.astro';
import DetailWindow from '../components/windows/DetailWindow.astro';
import { loadMap, DOCK_WINDOWS } from '../config/model';
import { path } from '../utils/path';
import { readingTime } from '../utils/reading-time';

const { model, posts, floors, defaultFloor } = await loadMap();
const windows = DOCK_WINDOWS.filter((item) => ['identity', 'legend', 'list', 'detail'].includes(item.id));

const byYear = new Map<number, typeof posts>();
for (const post of [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())) {
  const year = post.data.pubDate.getFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const years = [...byYear.entries()];
const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'short' });
---

<Layout title="全部文章 · LemonNK" floors={floors} activeFloor={defaultFloor}>
  <MapShell model={model} floor="all" mode="all" selectedId={model.nodes.at(-1)?.id} windows={windows}>
    <IdentityWindow />
    <LegendWindow model={model} />
    <DetailWindow nodes={model.nodes} selectedId={model.nodes.at(-1)?.id} />
    <ListWindow titleKey="list.archive" title="全部文章" labelled="全部文章">
      <h1 class="visually-hidden" data-i18n="archive.title">归档</h1>
      {years.map(([year, yearPosts]) => (
        <section class="year">
          <h2 class="year-label">{year}<span>{String(yearPosts.length).padStart(2, '0')}</span></h2>
          <ol class="year-list">
            {yearPosts.map((post) => (
              <li class="entry">
                <time datetime={post.data.pubDate.toISOString()}>
                  <span>{monthFormatter.format(post.data.pubDate).toUpperCase()}</span>
                  <strong>{String(post.data.pubDate.getDate()).padStart(2, '0')}</strong>
                </time>
                <div class="entry-copy">
                  <h3><a href={path(`/posts/${post.id}/`)}>{post.data.title}</a></h3>
                  <p class="entry-meta">
                    <span data-i18n="minRead" data-n={readingTime(post.body)}>约 {readingTime(post.body)} 分钟</span>
                    {post.data.tags.map((tag) => <a href={path(`/tags/${tag}/`)}>{tag}</a>)}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </ListWindow>
  </MapShell>
</Layout>

<style>
  .year + .year { margin-top: 20px; }
  .year-label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--glass-rim-outer);
    font-size: 15px;
    font-weight: 660;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  .year-label > span { color: var(--color-text-muted); font-size: var(--font-size-caption); font-weight: 500; }
  .year-list { display: grid; gap: 2px; margin-top: 8px; }
  .entry { display: grid; grid-template-columns: 42px minmax(0, 1fr); gap: 12px; padding: 7px 8px; border-radius: var(--radius-sm); transition: background 150ms ease; }
  .entry:hover { background: var(--glass-fill-strong); }
  .entry time { text-align: right; font-variant-numeric: tabular-nums; line-height: 1.25; }
  .entry time > span { display: block; font-size: var(--font-size-micro); letter-spacing: 0.08em; color: var(--color-text-muted); }
  .entry time > strong { display: block; font-size: 16px; font-weight: 600; letter-spacing: -0.04em; }
  .entry-copy { min-width: 0; }
  .entry-copy h3 { font-size: var(--font-size-card); font-weight: 580; line-height: 1.4; letter-spacing: -0.015em; }
  .entry-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 3px; font-size: var(--font-size-micro); color: var(--color-text-muted); }
  .entry-meta a { color: var(--color-text-muted); }
</style>
