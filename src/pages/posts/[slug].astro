---
import { getCollection, render } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import { readFile } from 'node:fs/promises';
import nodePath from 'node:path';
import remarkMath from 'remark-math';
import rehypeKatex from 'rehype-katex';
import rehypeExternalLinks from 'rehype-external-links';
import configuredEditions from '../../data/post-editions.json';
import PostLayout from '../../layouts/PostLayout.astro';
import { readingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.filter((post) => !post.data.draft).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const authoringMode = post.data.mode === 'me'
  ? (configuredEditions[post.id as keyof typeof configuredEditions] ?? 'me')
  : post.data.mode;
let aiContent = '';
if (authoringMode === 'dual') {
  try {
    const aiBody = await readFile(nodePath.join(process.cwd(), 'src', 'content', 'post-versions', `${post.id}.ai.md`), 'utf8');
    if (aiBody.trim()) {
      const markdown = await createMarkdownProcessor({
        remarkPlugins: [[remarkMath, { singleDollarTextMath: true }]],
        rehypePlugins: [
          [rehypeKatex, { throwOnError: false }],
          [rehypeExternalLinks, { target: '_blank', rel: ['noopener', 'noreferrer'] }],
        ],
        shikiConfig: {
          themes: {
            light: 'github-light',
            dark: 'github-dark',
          },
        },
      });
      aiContent = (await markdown.render(aiBody)).code;
    }
  } catch {
    // A dual post can be created before its AI edition has content.
  }
}
const allPosts = (await getCollection('posts')).filter((p) => !p.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const index = allPosts.findIndex((p) => p.id === post.id);
const prev = index > 0 ? allPosts[index - 1] : undefined;
const next = index < allPosts.length - 1 ? allPosts[index + 1] : undefined;
---

<PostLayout title={post.data.title} pubDate={post.data.pubDate} tags={post.data.tags} readingTime={readingTime(post.body)} authoringMode={authoringMode} aiContent={aiContent} prev={prev && { slug: prev.id, title: prev.data.title }} next={next && { slug: next.id, title: next.data.title }}>
  <Content />
</PostLayout>
