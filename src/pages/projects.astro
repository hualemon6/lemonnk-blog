---
import Layout from '../layouts/Layout.astro';
import MapShell from '../components/MapShell.astro';
import IdentityWindow from '../components/windows/IdentityWindow.astro';
import ListWindow from '../components/windows/ListWindow.astro';
import DetailWindow from '../components/windows/DetailWindow.astro';
import { loadMap, DOCK_WINDOWS } from '../config/model';
import { COLLECTION_FLOOR } from '../config/map';
import { projects } from '../config/projects';

const { model, floors } = await loadMap();
const windows = DOCK_WINDOWS.filter((item) => ['identity', 'list', 'detail'].includes(item.id));
const selected = model.nodes.find((node) => node.category === 'project');
const collectionPost = projects.at(0)?.id ? `project-${projects.at(0)!.id}` : undefined;
---

<Layout title="项目 · LemonNK" floors={floors} activeFloor={COLLECTION_FLOOR}>
  <MapShell model={model} floor={COLLECTION_FLOOR} mode="floor" selectedId={collectionPost ?? selected?.id} windows={windows}>
    <IdentityWindow />
    <DetailWindow nodes={model.nodes} selectedId={collectionPost ?? selected?.id} />
    <ListWindow titleKey="list.projects" title="项目" labelled="项目列表">
      <h1 class="visually-hidden" data-i18n="projects.title">项目</h1>
      <ol class="project-list">
        {projects.map((project, index) => (
          <li class="project">
            <p class="project-index">{String(index + 1).padStart(2, '0')}</p>
            <h2 class="project-name">
              {project.url
                ? <a href={project.url} target="_blank" rel="noopener noreferrer">{project.name}</a>
                : project.name}
            </h2>
            <p class="project-narrative">{project.narrativeZh || project.narrative}</p>
          </li>
        ))}
      </ol>
    </ListWindow>
  </MapShell>
</Layout>

<style>
  .project-list { display: grid; gap: 14px; }
  .project { padding: 12px 12px 14px; border-radius: var(--radius-md); background: color-mix(in srgb, var(--color-project) 6%, transparent); }
  .project-index { font-size: var(--font-size-micro); letter-spacing: 0.12em; color: var(--color-project); font-weight: 620; }
  .project-name { margin-top: 4px; font-size: 16px; font-weight: 640; letter-spacing: -0.025em; }
  .project-narrative { margin-top: 6px; font-size: var(--font-size-caption); line-height: 1.75; color: var(--color-text-muted); }
</style>
