---
import Layout from '../layouts/Layout.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { projects } from '../config/projects';
---

<Layout title="Projects">
  <section class="projects-experience" style={`--project-count: ${projects.length}`} data-project-experience>
    <div class="project-stage" data-project-stage>
      <aside class="project-rail" aria-label="Project progress">
        <p class="rail-label">PROJECTS</p>
        <p class="rail-count"><span data-project-current>01</span><span aria-hidden="true"> / </span><span>{String(projects.length).padStart(2, '0')}</span></p>
      </aside>
      <div class="project-panels">
      {projects.map((project, index) => <ProjectItem project={project} index={index} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .projects-experience { margin: clamp(4rem, 12vw, 8rem) 0 var(--space-lg); }
  .project-stage { display: grid; gap: var(--space-lg); grid-template-columns: 112px minmax(0, 1fr); }
  .project-rail { align-self: start; border-top: 1px solid var(--color-border); display: grid; gap: var(--space-xs); padding-top: var(--space-sm); }
  .rail-label, .rail-count { font-family: Georgia, 'Times New Roman', serif; letter-spacing: .1em; margin: 0; }
  .rail-label { color: var(--color-text-muted); font-size: 12px; }
  .rail-count { font-size: clamp(1.35rem, 2.5vw, 1.8rem); white-space: nowrap; }
  .project-panels { min-width: 0; }
  .project-panels :global(.project-panel) { border-top: 1px solid var(--color-border); padding: 0 0 var(--space-lg); }
  .project-panels :global(.project-panel + .project-panel) { padding-top: var(--space-lg); }
  .project-panels :global(.project-number) { color: var(--color-text-muted); font-family: Georgia, 'Times New Roman', serif; font-size: 13px; letter-spacing: .1em; margin: 0 0 var(--space-sm); }
  .project-panels :global(.project-copy) { max-width: 620px; }
  .project-panels :global(.project-panel h2) { display: inline; font-size: clamp(3rem, 6.2vw, 5.2rem); font-weight: 800; letter-spacing: -.085em; line-height: .94; margin: 0; overflow-wrap: normal; white-space: nowrap; }
  .project-panels :global(.project-panel h2 a) { transition: color 180ms ease; }
  .project-panels :global(.project-panel h2 a:hover) { color: var(--color-accent); }
  .project-panels :global(.project-narrative) { display: inline; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.18rem, 2.4vw, 1.55rem); line-height: 1.55; margin: 0 0 0 .22em; }
  .projects-experience.is-enhanced { height: calc(var(--project-count) * 100svh); margin: 0; }
  .projects-experience.is-enhanced .project-stage { align-items: center; height: 100svh; position: sticky; top: 0; }
  .projects-experience.is-enhanced .project-rail { align-self: center; }
  .projects-experience.is-enhanced .project-panels { height: min(64vh, 610px); position: relative; }
  .projects-experience.is-enhanced .project-panels :global(.project-panel) { display: block; inset: 0; opacity: 0; padding: 0; pointer-events: none; position: absolute; transform: translateY(20px); transition: opacity 360ms ease, transform 480ms cubic-bezier(.2,.8,.2,1); visibility: hidden; }
  .projects-experience.is-enhanced .project-panels :global(.project-panel.is-active) { opacity: 1; pointer-events: auto; transform: translateY(0); visibility: visible; }
  @media (max-width: 600px) {
    .projects-experience { margin-top: var(--space-lg); }
    .project-stage { gap: var(--space-md); grid-template-columns: 1fr; }
    .project-rail { display: flex; gap: var(--space-sm); justify-content: space-between; padding-top: var(--space-xs); }
    .rail-count { font-size: 1.1rem; }
    .project-panels :global(.project-panel h2) { font-size: clamp(2rem, 11.5vw, 3.5rem); }
    .project-panels :global(.project-narrative) { font-size: 1.06rem; line-height: 1.6; }
    .projects-experience.is-enhanced .project-stage { align-content: center; height: 100svh; }
    .projects-experience.is-enhanced .project-panels { height: min(62vh, 540px); }
    .projects-experience.is-enhanced .project-panels :global(.project-panel) { transform: translateY(14px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .projects-experience.is-enhanced .project-panels :global(.project-panel) { transition: none; transform: none; }
  }
</style>

<script>
  const experience = document.querySelector<HTMLElement>('[data-project-experience]');
  const stage = document.querySelector<HTMLElement>('[data-project-stage]');
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-project-panel]'));
  const current = document.querySelector<HTMLElement>('[data-project-current]');

  if (experience && stage && panels.length && current) {
    experience.classList.add('is-enhanced');
    let activeIndex = -1;
    let frame = 0;

    const setActive = (index: number) => {
      if (index === activeIndex) return;
      activeIndex = index;
      panels.forEach((panel, panelIndex) => {
        const active = panelIndex === index;
        panel.classList.toggle('is-active', active);
        panel.setAttribute('aria-hidden', String(!active));
      });
      current.textContent = String(index + 1).padStart(2, '0');
    };

    const updateActiveProject = () => {
      frame = 0;
      const start = experience.getBoundingClientRect().top + window.scrollY;
      const range = Math.max(1, experience.offsetHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, (window.scrollY - start) / range));
      setActive(Math.min(panels.length - 1, Math.round(progress * (panels.length - 1))));
    };

    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateActiveProject);
    };

    setActive(0);
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    requestUpdate();
  }
</script>
