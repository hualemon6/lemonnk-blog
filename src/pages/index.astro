---
import Layout from '../layouts/Layout.astro';
import MapShell from '../components/MapShell.astro';
import IdentityWindow from '../components/windows/IdentityWindow.astro';
import LegendWindow from '../components/windows/LegendWindow.astro';
import StatsWindow from '../components/windows/StatsWindow.astro';
import DetailWindow from '../components/windows/DetailWindow.astro';
import RecentWindow from '../components/windows/RecentWindow.astro';
import { loadMap, DOCK_WINDOWS } from '../config/model';

const { model, latest, minutes, years, defaultFloor, floors } = await loadMap();
const latestNode = model.nodes.find((node) => node.id === `post-${latest?.id}`) ?? model.nodes.at(-1);
const windows = DOCK_WINDOWS.filter((item) => ['identity', 'legend', 'stats', 'recent', 'detail'].includes(item.id));
---

<Layout title="沿途，皆是我 · LemonNK" floors={floors} activeFloor={defaultFloor}>
  <h1 class="visually-hidden" data-i18n="journey.title">沿途，皆是我</h1>
  <MapShell model={model} floor={defaultFloor} mode="floor" selectedId={latestNode?.id} windows={windows}>
    <IdentityWindow />
    <LegendWindow model={model} />
    <StatsWindow count={model.nodes.length} years={years} minutes={minutes} />
    <DetailWindow nodes={model.nodes} selectedId={latestNode?.id} />
    {latest && (
      <RecentWindow
        title={latest.data.title}
        slug={latest.id}
        date={latest.data.pubDate}
        body={latest.body}
        tags={latest.data.tags}
      />
    )}
  </MapShell>
</Layout>
